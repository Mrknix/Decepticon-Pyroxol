# Decepticon safe pentest environment template.
# Copy to .env inside the dedicated VM and fill in local-only values.

# LLM API keys. Configure at least one real key before starting agents.
ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
MINIMAX_API_KEY=your-minimax-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
NVIDIA_API_KEY=your-nvidia-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
XAI_API_KEY=your-xai-key-here
MISTRAL_API_KEY=your-mistral-key-here
GROQ_API_KEY=your-groq-key-here
TOGETHER_API_KEY=your-together-key-here
FIREWORKS_API_KEY=your-fireworks-key-here
COHERE_API_KEY=your-cohere-key-here
MOONSHOT_API_KEY=your-moonshot-key-here
ZAI_API_KEY=your-zai-key-here
DASHSCOPE_API_KEY=your-dashscope-key-here
GITHUB_TOKEN=your-github-models-token-here

# Match this to the key(s) you configure, for example:
# DECEPTICON_AUTH_PRIORITY=openai_api
# DECEPTICON_AUTH_PRIORITY=anthropic_api,openai_api
DECEPTICON_AUTH_PRIORITY=
DECEPTICON_AUTH_CLAUDE_CODE=false

# Keep initial testing cheap and low-risk. Change to eco after validation.
DECEPTICON_MODEL_PROFILE=test

# Local infrastructure secrets. Change these before client work.
LITELLM_MASTER_KEY=sk-decepticon-master-change-me
LITELLM_SALT_KEY=sk-decepticon-salt-change-me
POSTGRES_PASSWORD=decepticon-change-me
NEO4J_PASSWORD=decepticon-graph-change-me
BHCE_POSTGRES_PASSWORD=bhce-postgres-change-me
BHCE_NEO4J_PASSWORD=bhce-neo4j-change-me
BHCE_JWT_SIGNING_KEY=bhce-jwt-signing-key-change-me

# Optional tracing.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=decepticon

# Loopback-only service ports inside the VM.
LANGGRAPH_PORT=2024
LITELLM_PORT=4000
POSTGRES_PORT=5432
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
SKILLOGY_REST_PORT=9100
WEB_PORT=3000
TERMINAL_PORT=3003
BHCE_PORT=8081

# No specialist workloads by default. Keep this empty unless C2, AD/BHCE,
# reversing, the CLI container, or the web dashboard are explicitly needed.
COMPOSE_PROFILES=

# VM-local runtime data. Use an absolute path inside the VM when possible.
DECEPTICON_HOME=/home/decepticon/.decepticon
# DECEPTICON_ENGAGEMENT_WORKSPACE=/home/decepticon/.decepticon/workspace/client-engagement

# Empty keeps default decepticon-* container names and silences Compose
# interpolation warnings from the upstream stack.
DECEPTICON_STACK_NAME=

# Skillogy is the upstream default skill-retrieval backend. Keep enabled unless
# debugging standalone filesystem skill loading.
DECEPTICON_USE_SKILLOGY=1

# Disable update side effects during controlled assessments.
AUTO_UPDATE=false
DECEPTICON_DEBUG=false

# Optional local Ollama inside the VM only.
# OLLAMA_MODEL=llama3.2
# OLLAMA_API_BASE=http://127.0.0.1:11434
